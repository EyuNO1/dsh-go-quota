{
  "name": "@local/dsh-go-quota",
  "version": "0.2.0",
  "type": "module",
  "description": "OpenCode Go multi-account quota cards and key switcher for DeepSeek Harness (DSH).",
  "license": "MIT",
  "author": "dsh-go-quota contributors",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "opencode",
    "opencode-go",
    "quota",
    "usage",
    "multi-account"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/EyuNO1/dsh-go-quota.git"
  },
  "homepage": "https://github.com/EyuNO1/dsh-go-quota#readme",
  "bugs": {
    "url": "https://github.com/EyuNO1/dsh-go-quota/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}
